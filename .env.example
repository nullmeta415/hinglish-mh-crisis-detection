# Copy this file to ".env" and fill in your own credentials.
# The real ".env" is git-ignored and must never be committed.

# A random secret string used to hash usernames into anonymous IDs.
# Keep it stable across runs so the same user always maps to the same ID.
HARVEST_SALT=put-a-long-random-string-here

# YouTube Data API v3 key (https://console.cloud.google.com/ -> APIs -> YouTube Data API v3)
YOUTUBE_API_KEY=your-youtube-api-key

# Twitter/X browser cookies (DevTools -> Application -> Cookies -> x.com)
TWITTER_AUTH_TOKEN=your-x-auth_token-cookie
TWITTER_CT0=your-x-ct0-cookie

# Hugging Face token, only needed for gated models (https://huggingface.co/settings/tokens)
HF_TOKEN=your-huggingface-token
